# Firebase (required). Get from Firebase Console → Project settings → Your apps → Web app config.
# Never commit .env; copy this to .env and fill in your values.

REACT_APP_FIREBASE_API_KEY=AIzaSy...
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123:web:abc
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXX

# Which portfolios/{userId} document this site shows. Use the Firebase Auth uid
# of that person. Leave empty to show the first portfolio in the collection.
REACT_APP_PORTFOLIO_USER_ID=

# Optional: When true, show the "Under construction" banner instead of the portfolio.
# REACT_APP_SHOW_WIP_BANNER=false

# Web3Forms access key from https://web3forms.com (public by design; it ships in the client bundle).
# Create the key for the inbox that should receive contact-form mail. Free tier is 250 submissions/month.
# Create React App reads this at build time, so a host change needs a redeploy.
REACT_APP_WEB3FORMS_ACCESS_KEY=

# Mailto fallback when the key is missing or sending fails. Default: ankitjpatil28@gmail.com
# REACT_APP_CONTACT_EMAIL=ankitjpatil28@gmail.com